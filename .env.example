# ==============================================
# Valoración de Puestos MSC — Variables de Entorno
# ==============================================
# Copiar este archivo a .env y completar los valores

# ---- Base de Datos (PostgreSQL / Neon) ----
DATABASE_URL=postgresql://user:password@host:5432/valoracion_puestos_msc_db

# ---- Supabase (Catálogo de puestos - solo lectura) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- AI Agent (Ollama local) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder-v2:latest

# ---- Autenticación ----
# Secreto para firmar los JWT. Generar uno aleatorio y largo, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Sin esta variable, todas las rutas protegidas responden 500.
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Server ----
PORT=5000
NODE_ENV=development
